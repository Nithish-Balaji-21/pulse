APP_NAME="CoiioT: Real-Time Insights and IoT-powered Productivity"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_SEND_EMAIL=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,slow_queries
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_SLOW_QUERY_MS=2000

## Laravel nightwatch settings ##
# Off outside production. The package defaults to enabled, so keep this explicit.
NIGHTWATCH_ENABLED=false

## Database Configuration ##
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coiiot
DB_USERNAME=root
DB_PASSWORD=root

## Session Configuration ##
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=smartcoir.in,localhost,127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

## Horizon ##
# Comma-separated: grants dashboard access AND receives long-wait alerts
HORIZON_RECIPIENTS=

## Mail Configuration ##
MAIL_MAILER=smtp
MAIL_HOST=smtp.zoho.in
MAIL_PORT=587
MAIL_USERNAME=testing@coiiot.in
MAIL_PASSWORD=F4ZQi8b6KKTA
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=testing@coiiot.in
MAIL_FROM_NAME="Testing CoiioT"

## AWS Configuration ##
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

## CUSTOM CONFIGURATION ##
DATE_FORMAT="d/m/Y"
DATE_FORMAT_JS="DD/MM/YYYY"
TIME_FORMAT="h:i a"
DATE_TIME_FORMAT="d/m/Y h:i a"
DAY_DATE_ONLY_FORMAT="D, M j"

DAILY_DEVICE_CRON_AT=00:10
DAILY_DEVICE_CRON_START_GRACE_MINS=15
DAILY_PITH_CRON_INTERVAL_MINS=15
DAILY_FIBRE_CRON_INTERVAL_MINS=15
DAILY_SUB_MODULES_CRON_INTERVAL_MINS=15
DAILY_GROWBAGS_CRON_INTERVAL_MINS=15
DAILY_HUSKS_CRON_INTERVAL_MINS=35
TEAM_DISPATCH_STAGGER_SECS=30
TEAM_DISPATCH_WINDOW_MINS=30

## API KEYS ##
TOMORROW_IO_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
## Google Cloud key with the "Maps Static API" enabled + billing active.
## Restrict it by IP to the server(s) — it is used server-side only (weather site map).
GOOGLE_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

## COLORS CONFIGURATION ##
COLOR_SIDEBAR_BG="#fdfcfa"
COLOR_NAVBAR="#83211b"

COLOR_PRIMARY="#83211b"
COLOR_SECONDARY="#ce7716"
COLOR_TERTIARY="#a7490b"
COLOR_QUATERNARY="#d27b00ae"
COLOR_QUINARY="#b64b09db"
COLOR_4="#f4f3f3"

COLOR_6_MAIN="#1565c0"
COLOR_6_VARIANT="#64b5f6"

COLOR_7="#de817c"
COLOR_8="#ffffff"
COLOR_9="#000000"
COLOR_10="#969393"
COLOR_11="#444441"

## WATER METER CONFIGURATION ##
WATER_TOTAL_FIELD_ID="d27"
WATER_D16_FIELD_ID="d16"

## WATER TANK CONFIGURATION ##
WATER_TANK_FIELD_ID_UG=d29
WATER_TANK_FIELD_ID_OHT=d30

## LIMITS CONFIGURATION ##
WATER_METER_DAILY_LIMIT="100000"
WATER_METER_HOURLY_LIMIT="6000"
PITH_BLOCKS_DAILY_LIMIT="5000"
PITH_BLOCKS_HOURLY_LIMIT="250"
MINIBALES_DAILY_LIMIT="500"
MINIBALES_HOURLY_LIMIT="25"

## TWILIO CONFIGURATION ##
TWILIO_SID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+xxxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CONTENT_SID='xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'

## FCM CONFIGURATION ##
# Path to the FCM service-account JSON, set per server (not in git).
FCM_CREDENTIALS=

# Queue Monitor: authenticated superadmins only; payload replay is opt-in.
QUEUE_MONITOR_ENABLED=true
QUEUE_MONITOR_STORE_PAYLOAD=false
QUEUE_MONITOR_API_ENABLED=false
QUEUE_MONITOR_REFRESH_INTERVAL=15000
QUEUE_METRICS_PERSISTENCE=false
QUEUE_METRICS_PROMETHEUS_ENABLED=false
QUEUE_METRICS_TELEMETRY_ENABLED=false
QUEUE_METRICS_SCHEDULING_ENABLED=false
# For isolated local storage, use queue_monitor and create database/queue-monitor.sqlite.
# QUEUE_MONITOR_DB_CONNECTION=queue_monitor

# Expenses integration: Pulse reads Alam Cocos data from Expenses over HTTPS.
EXPENSES_APP_URL=https://expenses.coiiot.in
# Generate a NEW production secret on the server: openssl rand -hex 32
# Set EXPENSES_API_KEY below in Pulse's real .env.
# Set PULSE_API_KEY to the SAME secret in the Expenses app's real .env.
# Keep the secret server-side; never commit it or use VITE_ variables.
EXPENSES_API_KEY=

# Deployment (run in BOTH app directories after deploying their updates):
# composer install --no-dev --optimize-autoloader
# npm ci && npm run build
# php artisan migrate --force
# php artisan optimize:clear
# php artisan optimize
# Keep existing production APP_KEY, database, Redis and queue settings.
# Do not replace the production .env with this example file.
# Verify in Pulse: Alam Cocos > Reports > Expenses.
