APP_NAME="CoiioT: Real-Time Insights and IoT-powered Productivity"
APP_ENV=demo
APP_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,slow_queries
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_SLOW_QUERY_MS=2000

## Laravel nightwatch settings ##
# Off by default so demo traffic does not consume the production app's quota.
# To turn on: set true, add a token, append `nightwatch` to LOG_STACK above, and
# run `php artisan nightwatch:agent` as a supervised process on the demo host.
# NIGHTWATCH_SERVER defaults to the hostname, so demo stays separable from prod.
NIGHTWATCH_ENABLED=false

## Database Configuration ##
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coiiot_demo
DB_USERNAME=root
DB_PASSWORD=root

## Session Configuration ##
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=smartcoir.in,localhost,127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

## Mail Configuration ##
MAIL_MAILER=smtp
MAIL_HOST=smtp.zoho.in
MAIL_PORT=587
MAIL_USERNAME=testing@coiiot.in
MAIL_PASSWORD=F4ZQi8b6KKTA
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=testing@coiiot.in
MAIL_FROM_NAME="Testing CoiioT"

## AWS Configuration ##
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

## CUSTOM CONFIGURATION ##
DATE_FORMAT="d/m/Y"
DATE_FORMAT_JS="DD/MM/YYYY"
TIME_FORMAT="h:i a"
DATE_TIME_FORMAT="d/m/Y h:i a"
DAY_DATE_ONLY_FORMAT="D, M j"

DAILY_PITH_CRON_INTERVAL_MINS=30
DAILY_FIBRE_CRON_INTERVAL_MINS=30
DAILY_SUB_MODULES_CRON_INTERVAL_MINS=30
DAILY_GROWBAGS_CRON_INTERVAL_MINS=30
DAILY_HUSKS_CRON_INTERVAL_MINS=35

## API KEYS ##
TOMORROW_IO_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
## Google Cloud key with the "Maps Static API" enabled + billing active.
## Restrict it by IP to the server(s) — it is used server-side only (weather site map).
GOOGLE_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

## COLORS CONFIGURATION ##
COLOR_SIDEBAR_BG="#fdfcfa"
COLOR_NAVBAR="#83211b"

COLOR_PRIMARY="#83211b"
COLOR_SECONDARY="#ce7716"
COLOR_TERTIARY="#a7490b"
COLOR_QUATERNARY="#d27b00ae"
COLOR_QUINARY="#b64b09db"
COLOR_4="#f4f3f3"

COLOR_6_MAIN="#1565c0"
COLOR_6_VARIANT="#64b5f6"

COLOR_7="#de817c"
COLOR_8="#ffffff"
COLOR_9="#000000"
