{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-redis": "*",
        "barryvdh/laravel-dompdf": "^3.1",
        "cboxdk/laravel-queue-monitor": "^1.11",
        "kreait/firebase-php": "^7.19",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.48",
        "laravel/jetstream": "^5.1",
        "laravel/nightwatch": "^1.28",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^3.5",
        "maatwebsite/excel": "^4.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.4",
        "laravel/pint": "^1.17",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "test:rbac": [
            "pest tests/Pulse/Rbac --group=rbac --log-junit=storage/logs/rbac-junit.xml"
        ],
        "test:rbac:mobile": [
            "pest tests/Pulse/Rbac/RbacMobileApiTest.php --group=rbac --log-junit=storage/logs/rbac-mobile-junit.xml"
        ],
        "test:profanity": [
            "pest --profanity --exclude=sheet --compact"
        ],
        "test": [
            "pest --log-junit=storage/logs/test-junit.xml"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
