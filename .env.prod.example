APP_NAME="CoiioT: Real-Time Insights and IoT-powered Productivity"
APP_ENV=production
APP_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APP_DEBUG=false
APP_SEND_EMAIL=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://portal.coiioT.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,slow_queries,nightwatch
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_SLOW_QUERY_MS=1000

## Laravel nightwatch settings ##
# Requires the agent running as a supervised process on the same host:
#   php artisan nightwatch:agent   (verify with: php artisan nightwatch:status)
NIGHTWATCH_ENABLED=true
NIGHTWATCH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Logs only reach Nightwatch via the `nightwatch` channel in LOG_STACK above.
# This defaults to LOG_LEVEL (error) — raise it to see warnings from the IoT jobs.
NIGHTWATCH_LOG_LEVEL=warning
# Capture errors only. A reported exception is still captured at 100% below.
# 0.0 skips normal requests; reported exceptions are still captured at 100% below.
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.0
NIGHTWATCH_COMMAND_SAMPLE_RATE=0.0
NIGHTWATCH_EXCEPTION_SAMPLE_RATE=1.0
NIGHTWATCH_SCHEDULED_TASK_SAMPLE_RATE=0.0
# Retain these within the selected sample. Device readings are not sent because
# NIGHTWATCH_CAPTURE_REQUEST_PAYLOAD remains false.
NIGHTWATCH_IGNORE_CACHE_EVENTS=false
NIGHTWATCH_IGNORE_MAIL=false
NIGHTWATCH_IGNORE_NOTIFICATIONS=false
NIGHTWATCH_IGNORE_OUTGOING_REQUESTS=false
NIGHTWATCH_IGNORE_QUERIES=false

## Horizon and failed-job alerts ##
# Comma-separated Horizon dashboard operators and long-wait alert recipients.
HORIZON_RECIPIENTS=
# Use the production defaults. Temporarily set both to 5 when testing a queue-delay alert.
HORIZON_WAIT_DEFAULT_SECONDS=60
HORIZON_WAIT_NOTIFICATIONS_SECONDS=30
# Immediate email after a job has exhausted its retries. Uses HORIZON_RECIPIENTS,
# then active superadmin email addresses, when this list is blank.
FAILED_JOB_ALERTS_ENABLED=true
FAILED_JOB_ALERT_RECIPIENTS=

## External scheduler heartbeat ##
# Create a check with a 1-minute schedule and a 3-minute grace period, then put
# its private ping URL here. Do not commit the real URL.
SCHEDULER_HEARTBEAT_URL=
SCHEDULER_HEARTBEAT_TIMEOUT=5

## Database Configuration ##
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xxxxxx
DB_USERNAME=xxxx
DB_PASSWORD=xxxxxx

## Session Configuration ##
SESSION_DRIVER=database
SESSION_LIFETIME=129600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=coiiot.in,localhost,127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_PREFIX=coiiot_database_
HORIZON_PREFIX=coiiot_horizon:

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

## Mail Configuration ##
